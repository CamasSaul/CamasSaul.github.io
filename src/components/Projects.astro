---
import { portfolio } from '../data/portfolio';
---

<section id="projects" class="projects-section">
	<div class="projects-container">
		<h2 class="section-title">
			<span data-lang-es>&gt; Proyectos</span>
			<span data-lang-en>&gt; Projects</span>
		</h2>
		<div class="projects-grid">
			{portfolio.projects.map((project) => (
				<article class="project-card">
					<div class="project-cover">
						{project.cover ? (
							<img src={project.cover} alt={`Cover of ${project.title}`} loading="lazy" />
						) : (
							<div class="cover-placeholder">
								<span class="placeholder-text">{project.title.slice(0, 2).toUpperCase()}</span>
							</div>
						)}
					</div>
					<div class="project-body">
						<h3 class="project-title">{project.title}</h3>
						<p class="project-description">
							<span data-lang-es>{project.description.es}</span>
							<span data-lang-en>{project.description.en}</span>
						</p>
						<div class="project-tech">
							{project.tech.map((t) => <span class="tech-tag">{t}</span>)}
						</div>
					</div>
					<div class="project-actions">
						<a href={project.repo} target="_blank" rel="noopener noreferrer" class="action-btn repo">
							<svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
							<span>GitHub</span>
						</a>
						<a href={project.demo} target="_blank" rel="noopener noreferrer" class="action-btn demo">
							<svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M.5 3h3v1.17c-1.1.44-2.18 1.36-2.87 2.67h2.97v1.5H.16c.7 1.36 1.8 2.3 2.9 2.73V13h-3c-1.77 0-3-1.23-3-3s1.23-3 3-3zM15.5 3h-3V1.83c1.1-.44 2.18-1.36 2.87-2.67H12.4v-1.5h3.84c-.7-1.36-1.8-2.3-2.9-2.73V0h3c1.77 0 3 1.23 3 3s-1.23 3-3 3zM5 6.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm0 2a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zm6-2a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm0 2a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/></svg>
							<span>Demo</span>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.projects-section {
		padding: 2em 1em 2em;
	}
	.projects-container {
		max-width: 960px;
		margin: 0 auto;
	}
	.section-title {
		font-size: 1.8em;
		margin: 0 0 1.5em 0;
		text-align: center;
		color: var(--text-bright);
		font-family: "Courier New", Courier, monospace;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5em;
	}
	.project-card {
		border: 1px solid var(--border);
		background: var(--bg-card);
		overflow: hidden;
		transition: border-color 0.2s, transform 0.2s;
		display: flex;
		flex-direction: column;
		height: 380px;
		position: relative;
	}
	.project-card:hover {
		border-color: var(--text-bright);
		transform: translateY(-2px);
	}
	.project-cover {
		width: 100%;
		height: 160px;
		overflow: hidden;
		flex-shrink: 0;
	}
	.project-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: grayscale(100%);
		transition: filter 0.3s;
	}
	.project-card:hover .project-cover img {
		filter: grayscale(0%);
	}
	.cover-placeholder {
		width: 100%;
		height: 100%;
		background: var(--bg);
		display: flex;
		align-items: center;
		justify-content: center;
		border-bottom: 1px solid var(--border);
	}
	.placeholder-text {
		font-size: 2em;
		font-weight: 700;
		color: var(--border);
		font-family: "Courier New", Courier, monospace;
		letter-spacing: 0.1em;
	}
	.project-body {
		padding: 1.4em;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		overflow: hidden;
	}
	.project-title {
		font-size: 1.2em;
		margin: 0 0 0.8em 0;
		color: var(--text-bright);
		font-family: "Courier New", Courier, monospace;
	}
	.project-description {
		font-size: 0.9em;
		line-height: 1.6;
		color: var(--text);
		margin: 0 0 1em 0;
		flex-grow: 1;
		font-family: "Courier New", Courier, monospace;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}
	.project-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.tech-tag {
		font-size: 0.75em;
		padding: 0.2em 0.6em;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text-dim);
		font-family: "Courier New", Courier, monospace;
	}
	.project-actions {
		display: flex;
		border-top: 1px solid var(--border);
	}
	.action-btn {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		padding: 0.8em;
		text-decoration: none;
		font-size: 0.85em;
		font-family: "Courier New", Courier, monospace;
		transition: all 0.2s;
	}
	.action-btn.repo {
		background: var(--bg-card);
		color: var(--text-dim);
		border-right: 1px solid var(--border);
	}
	.action-btn.repo:hover {
		background: var(--bg);
		color: var(--text-bright);
		text-decoration: none;
	}
	.action-btn.demo {
		background: var(--bg-card);
		color: var(--text-bright);
		font-weight: 700;
	}
	.action-btn.demo:hover {
		background: var(--text-bright);
		color: var(--bg);
		text-decoration: none;
	}
	[data-lang-es],
	[data-lang-en] {
		display: inline;
	}
	html[data-lang="en"] [data-lang-es] {
		display: none;
	}
	html[data-lang="es"] [data-lang-en] {
		display: none;
	}
	@media (max-width: 768px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
		.section-title {
			font-size: 1.4em;
			margin-bottom: 2em;
		}
		.project-card {
			height: auto;
			min-height: 380px;
		}
		.project-cover {
			height: 140px;
		}
	}
</style>
