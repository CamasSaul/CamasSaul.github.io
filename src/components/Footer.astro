---
import { portfolio } from '../data/portfolio';
const today = new Date();
---

<footer>
	<p>&gt; &copy; {today.getFullYear()} {portfolio.name} // <span data-lang-es>Todos los derechos reservados</span><span data-lang-en>All rights reserved</span></p>
</footer>

<style>
	footer {
		padding: 2em 1em;
		text-align: center;
		color: var(--text-dim);
		font-size: 0.8em;
		border-top: 1px solid var(--border);
		font-family: "Courier New", Courier, monospace;
	}
	footer p {
		margin: 0;
	}
	[data-lang-es],
	[data-lang-en] {
		display: inline;
	}
	html[data-lang="en"] [data-lang-es] {
		display: none;
	}
	html[data-lang="es"] [data-lang-en] {
		display: none;
	}
</style>
