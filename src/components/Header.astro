---
import { portfolio } from '../data/portfolio';
---

<header>
	<nav aria-label="Navegación principal / Main navigation">
		<a href="#home" class="logo">{portfolio.name}</a>
		<button
			class="nav-toggle"
			type="button"
			aria-controls="primary-navigation"
			aria-expanded="false"
			aria-label="Menú / Menu"
		>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
		</button>
		<div class="nav-links" id="primary-navigation">
			<a href="#home">
				<span data-lang-es> Inicio </span>
				<span data-lang-en> Home </span>
			</a>
			<a href="#projects">
				<span data-lang-es> Proyectos </span>
				<span data-lang-en> Projects </span>
			</a>
			<a href="#skills"> Skills </a>
			<a href="#contact">
				<span data-lang-es> Contacto </span>
				<span data-lang-en> Contact </span>
			</a>
		</div>
		<div class="social-links">
			<a href={portfolio.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 16 16" width="20" height="20"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
			</a>
			<a
				href={encodeURI(portfolio.cv)}
				download={portfolio.cv.split('/').pop()}
				class="cv-link"
				aria-label="Descargar CV / Download CV"
				title="Descargar CV / Download CV"
			>
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
					<polyline points="14 2 14 8 20 8" />
					<line x1="12" y1="12" x2="12" y2="18" />
					<polyline points="9 15 12 18 15 15" />
				</svg>
				<span class="cv-label" aria-hidden="true">CV</span>
			</a>
		</div>
	</nav>
</header>
<script>
	const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const navLinks = document.querySelector<HTMLElement>('#primary-navigation');

	function closeMenu() {
		navToggle?.setAttribute('aria-expanded', 'false');
		navLinks?.classList.remove('is-open');
	}

	navToggle?.addEventListener('click', () => {
		const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
		navToggle.setAttribute('aria-expanded', String(!isOpen));
		navLinks?.classList.toggle('is-open', !isOpen);
	});

	navLinks?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});

	window.addEventListener('resize', () => {
		if (window.innerWidth > 700) closeMenu();
	});
</script>
<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		margin: 0;
		padding: 0 2em;
		padding: 0 max(2em, env(safe-area-inset-right)) 0 max(2em, env(safe-area-inset-left));
		background: rgba(10, 10, 10, 0.95);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		height: var(--header-height);
	}
	.logo {
		font-size: 1em;
		font-weight: 700;
		color: var(--text-bright);
		text-decoration: none;
		font-family: "Courier New", Courier, monospace;
		white-space: nowrap;
	}
	.logo:hover {
		text-decoration: none;
	}
	.nav-toggle {
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		padding: 0;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-bright);
		cursor: pointer;
	}
	.nav-toggle-bar {
		display: block;
		width: 20px;
		height: 2px;
		background: currentColor;
		transition: transform 0.2s, opacity 0.2s;
	}
	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}
	.nav-links {
		display: flex;
		gap: 1.8em;
	}
	.nav-links a {
		font-size: 0.85em;
		color: var(--text-dim);
		text-decoration: none;
		transition: color 0.2s;
		font-family: "Courier New", Courier, monospace;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.nav-links a:hover {
		color: var(--text-bright);
		text-decoration: none;
	}
	.social-links {
		display: flex;
		gap: 0.8em;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		color: var(--text-dim);
		transition: color 0.2s;
	}
	.social-links a:hover {
		color: var(--text-bright);
	}
	.social-links a.cv-link {
		gap: 0.35em;
		padding: 0 0.3em;
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.05em;
	}
	.social-links a.cv-link:hover {
		color: var(--text-bright);
	}
	[data-lang-es],
	[data-lang-en] {
		display: inline;
	}
	html[data-lang="en"] [data-lang-es] {
		display: none;
	}
	html[data-lang="es"] [data-lang-en] {
		display: none;
	}
	@media (max-width: 700px) {
		header {
			padding: 0 1em;
			padding: 0 max(1em, env(safe-area-inset-right)) 0 max(1em, env(safe-area-inset-left));
		}
		nav {
			justify-content: flex-start;
			gap: 0.25em;
		}
		.logo {
			margin-right: auto;
		}
		.social-links {
			order: 1;
			gap: 0.25em;
		}
		.nav-toggle {
			order: 2;
			display: flex;
			border: 0;
			color: var(--text-dim);
			margin-left: 0.15em;
		}
		.nav-toggle:hover {
			color: var(--text-bright);
		}
		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			gap: 0;
			padding: 0.25em 1em 0.5em;
			padding: 0.25em max(1em, env(safe-area-inset-right)) 0.5em max(1em, env(safe-area-inset-left));
			background: rgba(10, 10, 10, 0.98);
			border-bottom: 1px solid var(--border);
			box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
		}
		.nav-links.is-open {
			display: flex;
		}
		.nav-links a {
			display: flex;
			align-items: center;
			min-height: 48px;
			font-size: 0.95em;
			letter-spacing: 0.06em;
			border-bottom: 1px solid var(--border);
		}
		.nav-links a:last-child {
			border-bottom: 0;
		}
	}
</style>
